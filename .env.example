# ==============================================================================
# OFFDATA & CompanyOS — Canonical Environment Contract (v2.0)
# Copy to .env.local for local development inside Antigravity.
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. INSTITUTIONAL SURFACES & DOMAIN TOPOLOGY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COMPANYOS_URL="http://localhost:3000"
NEXT_PUBLIC_CLIENT_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_CORPORATE_SITE_URL="http://localhost:3002"
NEXT_PUBLIC_DEMO_SANDBOX_URL="http://localhost:3003"

# Internal HQ seed UUIDs (matches 0001_companyos_kernel.sql Section 11)
OFFDATA_INTERNAL_TENANT_ID="00000000-0000-4000-8000-000000000001"
OFFDATA_HQ_WORKSPACE_ID="00000000-0000-4000-8000-000000000101"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL 16 + RLS + REALTIME
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-supabase-anon-key"
SUPABASE_JWT_SECRET="replace-with-local-supabase-jwt-secret-min-32-chars"

# SECURITY LAW: Used ONLY by migration scripts & verified Stripe/Resend webhook
# ingesters. NEVER pass SUPABASE_SERVICE_ROLE_KEY into @offdata/agent-os workers.
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. MODEL ROUTER, MANDATORY 1536-DIM EMBEDDINGS & SPATIAL VOICE PINS
# ------------------------------------------------------------------------------
AI_GATEWAY_BASE_URL="https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/offdata-os"
AI_GATEWAY_API_KEY="replace-with-gateway-token"

GEMINI_API_KEY="replace-with-gemini-api-key"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
OPENAI_API_KEY="replace-with-openai-api-key"

# Mandatory 1536-dimension pgvector invariant (GEMINI.md Law 4.1)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL_ID="gemini-embedding-001"
EMBEDDING_DIMENSIONS="1536"

# Powers POST /api/studio/voice-transcribe (Hold-Space-to-Speak Spatial Pins)
VOICE_TRANSCRIPTION_MODEL_ID="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 4. DURABLE ORCHESTRATION (TRIGGER.DEV v3+)
# ------------------------------------------------------------------------------
TRIGGER_PROJECT_ID="proj_offdata_companyos"
TRIGGER_SECRET_KEY="tr_dev_replace_with_trigger_secret"
TRIGGER_API_URL="https://api.trigger.dev"

# ------------------------------------------------------------------------------
# 5. DUAL-MODE LIVE COMPUTER POOL & ZERO-KNOWLEDGE VAULT PROXY
# ------------------------------------------------------------------------------
# Allowed values: "docker_local" | "e2b_cloud" | "headless_ci"
SANDBOX_DRIVER="docker_local"
SANDBOX_DOCKER_IMAGE="offdata/sandbox-base:local"
SANDBOX_HOST_BIND_IP="127.0.0.1"
SANDBOX_PROXY_SIGNING_SECRET="replace-with-32-byte-hex-proxy-hmac-secret"
E2B_API_KEY="e2b_replace_for_production_cloud_microvms"

# Zero-Knowledge Vault backing values (resolved ONLY inside outbound proxy;
# agents receive symbolic refs like {{VAULT:SANDBOX_MOCK_API_KEY}})
VAULT_SECRET_SANDBOX_MOCK_API_KEY="mock_sandbox_token_dev_only"
VAULT_SECRET_QA_SYNTHETIC_TEST_INBOX_TOKEN="qa_inbox_token_dev_only"

# ------------------------------------------------------------------------------
# 6. REA & CRAFT ANYTHING ENGINE GUARDRAILS
# ------------------------------------------------------------------------------
REA_MCP_TOOL_CATALOG_PROFILE="hot-cold"
REA_MAX_EXPOSED_TOOLS="15"
CRAFT_DEFAULT_MODE="clean-room"

# ------------------------------------------------------------------------------
# 7. COMMERCIAL, INGESTION, TELEMETRY & TRUE-COST ECONOMICS
# ------------------------------------------------------------------------------
FOUNDER_SHADOW_HOURLY_RATE_USD="250.00"
PRINCIPAL_EDITORIAL_BYLINE="Ray Zheng — Managing Principal, OFFDATA"

STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_HTTP402_SIGNING_KEY="replace-with-http402-meter-hmac-key"

RESEND_API_KEY="re_replace_me"
RESEND_INBOUND_WEBHOOK_SECRET="whsec_resend_inbound_replace_me"
NANGO_SECRET_KEY="nango_dev_replace_me"

SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""